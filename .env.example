# Never commit your real key.
# Option A (recommended for Alibaba Cloud hackathons): Alibaba Cloud Model Studio / DashScope
DASHSCOPE_API_KEY=sk-your-key
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# Option B: any OpenAI-compatible host serving Qwen, e.g. Groq
# QWEN_BASE_URL=https://api.groq.com/openai/v1
# QWEN_MODEL=qwen/qwen3.8-27b
# Max output tokens per AI step (lower it on free tiers with tight per-minute limits)
QWEN_MAX_TOKENS=900
